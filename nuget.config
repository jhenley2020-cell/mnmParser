<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <!--
    <clear/> drops any inherited/machine feeds; then we add just nuget.org.
    The App project needs one real package (System.Speech, for the voice
    callouts). The first `dotnet build` after a clean checkout needs
    internet to fetch it (and the Windows Desktop targeting pack); both are
    cached locally after that.
  -->
  <packageSources>
    <clear />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" protocolVersion="3" />
  </packageSources>
</configuration>
